# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Next.js & Frontend Builds
.next/
*/.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Python & Backend
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/

# Environment Variables & Secrets (Keep example files)
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.swp
